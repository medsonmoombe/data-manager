    "@prisma/client": "^7.8.0",
    "@types/cache-manager-redis-store": "^2.0.4",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
